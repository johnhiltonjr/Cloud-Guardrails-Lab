# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plans
*.tfplan
tfplan

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS/editor files
.DS_Store
Thumbs.db

# Keep Terraform dependency lock files
!**/.terraform.lock.hcl

# Terraform backend configuration

# Review documents
*-review.txt
**/backend.hcl

# Terraform plan JSON produced in CI
plan.json

